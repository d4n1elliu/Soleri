# Spotify application credentials — get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The URL Spotify redirects to after login (must match the redirect URI in your Spotify app settings)
REDIRECT_URI=http://localhost:3000/

# Vite client-side env var — only needed if you want the client to display the client ID
# VITE_SPOTIFY_CLIENT_ID=

# Canonical site origin used by the SEO prerenderer (scripts/prerender.mjs)
# for canonical URLs, Open Graph tags, robots.txt and sitemap.xml
VITE_SITE_URL=https://soleri.fyi
